{
  "name": "nestjs-jwts",
  "type": "module",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --env-file .env/.env.dev",
    "start:dev": "nest start --watch --env-file .env/.env.dev",
    "start:debug": "nest start --debug --watch --env-file .env/.env.dev",
    "start:prod": "node --env-file=.env/.env.prod dist/main.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "node --env-file=.env/.env.dev node_modules/prisma/build/index.js migrate dev",
    "db:migrate:prod": "node --env-file=.env/.env.prod node_modules/prisma/build/index.js migrate deploy",
    "db:reset:dev": "node --env-file=.env/.env.dev node_modules/prisma/build/index.js migrate reset",
    "db:studio:dev": "node --env-file=.env/.env.dev node_modules/prisma/build/index.js studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-node": "^12.3.3",
    "@nestjs/swagger": "^12.1.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.3",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^17.4.2",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
