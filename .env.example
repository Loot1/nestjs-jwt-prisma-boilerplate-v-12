# Copy to .env (dev) and .env.test.local (tests, separate database).
# On a server that requires TLS, both parameters are needed:
#   sslaccept=strict -> read by the Prisma CLI (migrations)
#   ssl=true         -> read by the MariaDB driver adapter (runtime)
DATABASE_URL="mysql://root:123@localhost:3307/nestjs"
SHADOW_DATABASE_URL="mysql://root:123@localhost:3307/nestjs_shadow"
AT_SECRET=at-secret
RT_SECRET=rt-secret